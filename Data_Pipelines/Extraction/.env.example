# Copy this file to .env and fill in the real values. .env is git-ignored.
#
# Project API URL (not used for database export).
SUPABASE_URL=https://<project-ref>.supabase.co

# PostgreSQL connection string.
#
# Use the Supavisor pooler connection, not the direct db.<project-ref>.supabase.co
# host: the direct host is IPv6-only and times out on IPv4-only networks.
# Get the exact string from Supabase Dashboard > Connect > Connection string.
# URL-encode special characters in the password (for example, # becomes %23).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-<region>.pooler.supabase.com:5432/postgres
